# ── 数据与模型：绝不进仓库（可能几 GB） ─────────────────────────
/data/
/models/
# 🔴 `/data/` 开头的斜杠只锁根目录，**盖不住 engine/data/** ——
#    单独跑引擎（engine:dev）时它会在那儿建一份运行时数据：
#    engine.json 里有本机绝对路径和 PID，websearch-health.json 是搜索行为统计，
#    还有索引库本体。2026-08-03 转公开前的扫描当场抓到它们已经进了暂存区。
engine/data/
apps/desktop/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Python ────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# ── Node ──────────────────────────────────────────────────────
node_modules/
.vite/

# ── git worktree 挂载点 ───────────────────────────────────────
# 分支隔离用 `git worktree add .worktrees/<名字> -b <分支>` 在这里开，
# 每个挂载点自带一份完整检出和 node_modules。它**不是**仓库内容，
# 漏了这一条，主工作区的 git status 会被几十万行依赖文件淹掉。
.worktrees/
out/
release/
*.tsbuildinfo

# ── Android ───────────────────────────────────────────────────
apps/mobile/.gradle/
apps/mobile/build/
apps/mobile/**/build/
apps/mobile/local.properties
apps/mobile/.idea/
*.apk
*.aab
*.keystore
*.jks
# 🔴 release 签名的密钥库口令。仓库要转公开，这个文件进 git 就等于把
#    签名密钥的密码公开——别人能拿它签一个假的 Synorive 覆盖安装到用户手机上。
#    模板见 apps/mobile/keystore.properties.example
apps/mobile/keystore.properties

