{
  "name": "synorive",
  "version": "0.1.10",
  "description": "Synorive — 多模态并发分析与极速内容检索平台",
  "keywords": [
    "semantic-search",
    "local-first",
    "offline",
    "multimodal",
    "rag",
    "vector-search",
    "hybrid-search",
    "ocr",
    "mcp",
    "mcp-server",
    "claude-code",
    "electron",
    "fastapi",
    "sqlite",
    "privacy"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Aevorine",
  "homepage": "https://github.com/Aevorine/Synorive#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aevorine/Synorive.git"
  },
  "bugs": "https://github.com/Aevorine/Synorive/issues",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/desktop",
    "mcp",
    "cli"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@synorive/desktop",
    "build": "npm run build --workspaces --if-present",
    "build:tokens": "npm run build --workspace=@synorive/design-tokens",
    "build:desktop": "npm run build --workspace=@synorive/desktop",
    "build:icons": "node scripts/build-icons.mjs",
    "engine:dev": "engine/.venv/Scripts/python.exe -m synorive.main --reload",
    "lint:tokens": "node scripts/check-hardcoded-style.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "version:check": "node scripts/set-version.mjs --check",
    "version:set": "node scripts/set-version.mjs",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/release.mjs --publish",
    "android:keystore": "node scripts/make-android-keystore.mjs",
    "lint:tooltips": "node scripts/check-icon-tooltips.mjs",
    "lint": "npm run lint:tokens && npm run lint:tooltips"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
