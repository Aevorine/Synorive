{
  "name": "@synorive/desktop",
  "version": "0.1.2",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Synorive —— 多模态并发分析与极速内容检索",
  "author": "Synorive",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node ../../scripts/ensure-fonts.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node ../../scripts/ensure-fonts.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack:runtime": "node ../../scripts/bundle-python.mjs",
    "pack:dir": "npm run prepack:runtime && npm run build && electron-builder --dir",
    "pack:win": "npm run prepack:runtime && npm run build && electron-builder --win",
    "pack:win:slim": "node ../../scripts/bundle-python.mjs --slim && npm run build && electron-builder --win",
    "publish:win": "npm run prepack:runtime && npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@synorive/design-tokens": "*",
    "@synorive/shared-types": "*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@tanstack/react-virtual": "^3.11.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "zustand": "^5.0.3"
  }
}
